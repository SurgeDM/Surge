{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Surge capabilities version 1",
  "type": "object",
  "required": [
    "schema_version",
    "version",
    "commands",
    "schemas",
    "limits",
    "units",
    "features"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "version": {
      "type": "string"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schemas": {
      "type": "object",
      "additionalProperties": {
        "const": 1
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "units": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "server": {
      "type": "object"
    }
  }
}
