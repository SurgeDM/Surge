{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Surge events version 1",
  "type": "object",
  "required": [
    "schema_version",
    "type"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "type": {
      "enum": [
        "snapshot",
        "state_changed",
        "progress",
        "resync_required",
        "error"
      ]
    },
    "epoch": {
      "type": "string"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "time": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "error": {
      "type": "object"
    }
  }
}
