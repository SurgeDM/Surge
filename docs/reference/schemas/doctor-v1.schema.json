{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Surge doctor version 1",
  "type": "object",
  "required": [
    "schema_version",
    "ok",
    "scope",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "ok": {
      "type": "boolean"
    },
    "scope": {
      "enum": [
        "local",
        "server"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status",
          "message"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "info",
              "warning",
              "error"
            ]
          },
          "message": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        }
      }
    }
  }
}
