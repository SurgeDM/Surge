{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Surge lifecycle output version 1",
  "type": "object",
  "required": [
    "schema_version",
    "operation",
    "ok",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation": {
      "enum": [
        "pause",
        "resume",
        "cancel"
      ]
    },
    "ok": {
      "type": "boolean"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/receipt"
      }
    },
    "error": {
      "$ref": "#/$defs/failure"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "error"
          ]
        }
      },
      "else": {
        "required": [
          "error"
        ]
      }
    }
  ],
  "$defs": {
    "failure": {
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "enum": [
            "operation_failed",
            "invalid_arguments",
            "partial_failure",
            "not_found",
            "unauthorized",
            "unavailable",
            "conflict",
            "timeout",
            "interrupted", "terminated"
          ]
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "receipt": {
      "type": "object",
      "required": [
        "id",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "requested",
            "failed",
            "unknown",
            "not_requested"
          ]
        },
        "error": {
          "$ref": "#/$defs/failure"
        }
      }
    }
  }
}
