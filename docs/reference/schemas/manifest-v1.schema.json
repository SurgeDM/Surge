{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Surge manifest version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "client_ref",
          "url"
        ],
        "properties": {
          "client_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "mirrors": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^https?://"
            }
          },
          "output": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]{64}$"
          },
          "on_exists": {
            "enum": [
              "fail",
              "rename"
            ]
          }
        }
      }
    }
  }
}
