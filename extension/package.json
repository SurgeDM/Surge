{
  "name": "surge-extension",
  "description": "Surge Download Manager browser extension",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:edge": "wxt zip -b edge",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "pretest": "wxt prepare",
    "test": "vitest run"
  },
  "dependencies": {
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "eslint-plugin-solid": "^0.18.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  },
  "overrides": {
    "eslint-plugin-solid": {
      "eslint": "$eslint"
    }
  }
}
